{
  "title": "Lawtech-AI — Application Health & Usage",
  "uid": "lawtech-main",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "uid": "lawtech-prometheus" },
        "query": "label_values(up, job)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / min",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(job) (rate(lawtech_requests_total{job=~\"$job\"}[1m])) * 60",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(job) (rate(lawtech_requests_total{job=~\"$job\", status_code=~\"5..\"}[5m])) / sum by(job) (rate(lawtech_requests_total{job=~\"$job\"}[5m])) * 100",
          "legendFormat": "{{job}} 5xx"
        },
        {
          "expr": "sum by(job) (rate(lawtech_requests_total{job=~\"$job\", status_code=~\"4..\"}[5m])) / sum by(job) (rate(lawtech_requests_total{job=~\"$job\"}[5m])) * 100",
          "legendFormat": "{{job}} 4xx"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 3,
      "title": "Request Latency P95 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le, endpoint, job) (rate(lawtech_request_latency_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "{{job}} — {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 4,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum by(job) (lawtech_active_requests{job=~\"$job\"})", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [
          { "color": "green", "value": 0 },
          { "color": "yellow", "value": 10 },
          { "color": "red", "value": 25 }
        ]}}
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 13,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "targets": [
        { "expr": "up{job=~\"$job\"}", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "mappings": [
          { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
        ]}
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Agent Invocations / min",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(agent, job) (rate(lawtech_agent_invocations_total{job=~\"$job\"}[5m])) * 60",
          "legendFormat": "{{job}} — {{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm" }
      }
    },
    {
      "id": 6,
      "title": "Fallback Rate by Agent",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(agent, tier, job) (rate(lawtech_fallback_total{job=~\"$job\"}[5m])) * 60",
          "legendFormat": "{{job}} — {{agent}} / {{tier}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm" }
      }
    },
    {
      "id": 7,
      "title": "Task Type Distribution",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(task_type) (increase(lawtech_tasks_planned_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{ task_type }}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Guardrail Blocks / hour",
      "type": "stat",
      "gridPos": { "x": 12, "y": 24, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum by(job) (increase(lawtech_guardrail_blocks_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [
          { "color": "green", "value": 0 },
          { "color": "yellow", "value": 5 },
          { "color": "red", "value": 20 }
        ]}}
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 9,
      "title": "Total Tokens / hour",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(job) (increase(lawtech_llm_tokens_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "purple", "mode": "fixed" } }
      }
    },
    {
      "id": 10,
      "title": "Fallback Rate % (web search)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(job) (rate(lawtech_fallback_total{job=~\"$job\", tier='web_search'}[5m])) / sum by(job) (rate(lawtech_requests_total{job=~\"$job\"}[5m])) * 100",
          "legendFormat": "{{job}} web fallback %"
        },
        {
          "expr": "sum by(job) (rate(lawtech_fallback_total{job=~\"$job\", tier='query_rewrite'}[5m])) / sum by(job) (rate(lawtech_requests_total{job=~\"$job\"}[5m])) * 100",
          "legendFormat": "{{job}} query rewrite %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*web fallback.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 11,
      "title": "Response Quality Scores (sampled 10%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 40, "w": 16, "h": 8 },
      "targets": [
        {
          "expr": "lawtech_quality_avg_score{job=~\"$job\"}",
          "legendFormat": "{{job}} avg score"
        },
        {
          "expr": "lawtech_quality_faithfulness{job=~\"$job\"}",
          "legendFormat": "{{job}} faithfulness"
        },
        {
          "expr": "lawtech_quality_relevance{job=~\"$job\"}",
          "legendFormat": "{{job}} relevance"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.6 },
            { "color": "green", "value": 0.8 }
          ]}
        }
      }
    },
    {
      "id": 12,
      "title": "Low Quality Alerts (score < 0.6)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 40, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "lawtech_quality_low_count{job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [
          { "color": "green", "value": 0 },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 5 }
        ]}}
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
