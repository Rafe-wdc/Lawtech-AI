[Unit]
Description=Lawttorney v2 API (gunicorn + uvicorn workers, multi-worker)
Documentation=file:///root/Lawtech-AI/docs/scale_50_concurrent_users_plan.md
After=network-online.target postgresql.service
Wants=network-online.target
# Embeddings are loaded in-process by each gunicorn worker (see
# core.clients.get_retriever_embeddings). The lawttorney-embed service
# is kept available for opt-in remote mode but is not a hard dependency.
# Phase 5 will add: Requires=lawttorney-chroma.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Lawtech-AI
EnvironmentFile=/root/Lawtech-AI/.env

# Phase 6: Prometheus multi-worker support. systemd creates this dir on
# service start with the right ownership and wipes it on service stop
# (RuntimeDirectoryPreserve=no is the default). Workers write their per-pid
# counter/gauge files here; the /pyapi/metrics endpoint aggregates across
# them via MultiProcessCollector.
Environment=PROMETHEUS_MULTIPROC_DIR=/run/lawtech-prom
RuntimeDirectory=lawtech-prom
RuntimeDirectoryMode=0755

ExecStart=/root/Lawtech-AI/venv/bin/gunicorn -c gunicorn.conf.py core.gateway:app
# Graceful reload (SIGHUP) — gunicorn rotates workers without dropping connections.
ExecReload=/bin/kill -HUP $MAINPID

# Restart on crash, with backoff to avoid tight loops.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# File-descriptor limit — 6 workers × 50 active SSE streams × ~3 sockets per
# request (client + ES + LLM) = ~900 baseline; 65536 leaves room for bursts.
LimitNOFILE=65536

# Memory cap to surface leaks (workers also rotate via gunicorn max_requests).
# 32 GB box - other services - generous slack = leave ~22 GB for the API.
MemoryHigh=20G
MemoryMax=24G

# stdout/stderr → journald (rotated by systemd). Per-line structured logs in
# agent.log are still rotated by Python RotatingFileHandler.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lawttorney-v2

[Install]
WantedBy=multi-user.target
