# ── Lawtech-AI — Production Server .env Template ──────────────────────────────
#
# Copy this file to /root/v2_multi_agent/.env on the server.
# Fill in real values. This file is NEVER overwritten by CI/CD.
# DO NOT commit this file with real secrets.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Required API Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
GOOGLE_API_KEY="AIza..."

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate strong random keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS="key1,key2"          # comma-separated user-facing API keys
ADMIN_API_KEY="admin-key"     # single key for /admin/* and /metrics

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS="https://tool.lawttorney.com"

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by BOTH the LangGraph checkpointer AND the chat history store.
# If running PostgreSQL locally on the server:
POSTGRES_URL="postgresql://lawtech:CHANGE_ME@localhost:5432/lawtech"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20      # per IP; raise after load testing

# ── Server ────────────────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT="5001"                   # lawtech-v2 listens on 5001

# ── Elasticsearch / OpenSearch ────────────────────────────────────────────────
ES_URL="https://search-lawttorney-search-dyx7nzptixefpve6jeovqrt4mi.ap-south-1.es.amazonaws.com"
ES_USER="CHANGE_ME"
ES_PASSWORD="CHANGE_ME"

# ── Optional: leave commented to use defaults ─────────────────────────────────
# S3_BUCKET="lawttorney"
# S3_REGION="ap-south-1"
# REDIS_URL="redis://localhost:6379"
# LOG_LEVEL="INFO"
# EMBEDDING_SERVICE_URL=""    # set to http://localhost:5100 for remote embeddings
