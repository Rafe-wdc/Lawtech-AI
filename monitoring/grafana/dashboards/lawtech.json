{
  "title": "Lawtech-AI — Application Health & Usage",
  "uid": "lawtech-main",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests / min",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(lawtech_requests_total[1m])) * 60",
          "legendFormat": "req/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(lawtech_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(lawtech_requests_total[5m])) * 100",
          "legendFormat": "5xx error %"
        },
        {
          "expr": "sum(rate(lawtech_requests_total{status_code=~\"4..\"}[5m])) / sum(rate(lawtech_requests_total[5m])) * 100",
          "legendFormat": "4xx error %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx error %" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 3,
      "title": "Request Latency P95 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le, endpoint) (rate(lawtech_request_latency_seconds_bucket[5m])))",
          "legendFormat": "{{ endpoint }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 4,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "targets": [
        { "expr": "lawtech_active_requests", "legendFormat": "active" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [
          { "color": "green", "value": 0 },
          { "color": "yellow", "value": 10 },
          { "color": "red", "value": 25 }
        ]}}
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "title": "Agent Invocations / min",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(agent) (rate(lawtech_agent_invocations_total[5m])) * 60",
          "legendFormat": "{{ agent }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm" }
      }
    },
    {
      "id": 6,
      "title": "Fallback Rate by Agent",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(agent, tier) (rate(lawtech_fallback_total[5m])) * 60",
          "legendFormat": "{{ agent }} / {{ tier }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm" }
      }
    },
    {
      "id": 7,
      "title": "Task Type Distribution",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by(task_type) (increase(lawtech_tasks_planned_total[1h]))",
          "legendFormat": "{{ task_type }}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Guardrail Blocks / hour",
      "type": "stat",
      "gridPos": { "x": 12, "y": 24, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(lawtech_guardrail_blocks_total[1h]))",
          "legendFormat": "blocks"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "steps": [
          { "color": "green", "value": 0 },
          { "color": "yellow", "value": 5 },
          { "color": "red", "value": 20 }
        ]}}
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 9,
      "title": "Total Tokens / hour",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(increase(lawtech_llm_tokens_total[1h]))",
          "legendFormat": "tokens/hour"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "purple", "mode": "fixed" } }
      }
    },
    {
      "id": 10,
      "title": "Fallback Rate % (web search)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(lawtech_fallback_total{tier='web_search'}[5m])) / sum(rate(lawtech_requests_total[5m])) * 100",
          "legendFormat": "web fallback %"
        },
        {
          "expr": "sum(rate(lawtech_fallback_total{tier='query_rewrite'}[5m])) / sum(rate(lawtech_requests_total[5m])) * 100",
          "legendFormat": "query rewrite %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "web fallback %" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      }
    }
  ]
}
