# ── Lawtech-AI — Local Dev .env Template ──────────────────────────────────────
#
# cp .env.example .env   →  then fill in your real keys.
# See .env.production for the server template.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Required API Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
GOOGLE_API_KEY="AIza..."

# ── Auth (leave empty = open dev mode, startup warning shown) ─────────────────
API_KEYS=""
ADMIN_API_KEY=""

# ── CORS (open for local dev) ─────────────────────────────────────────────────
ALLOWED_ORIGINS="*"

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Leave empty → falls back to SQLite (fine for solo dev, not for multi-worker).
# Set this if you run Postgres locally (e.g. Docker):
#   docker run -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=lawtech -p 5432:5432 postgres:16
# POSTGRES_URL="postgresql://postgres:dev@localhost:5432/lawtech"
POSTGRES_URL=""

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=200     # high limit for local testing

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# ELASTICSEARCH_URL="http://139.84.219.174:9200"
# S3_BUCKET="lawttorney"
# S3_REGION="ap-south-1"
# REDIS_URL="redis://localhost:6379"
# HOST="0.0.0.0"
# PORT="5000"
# LOG_LEVEL="DEBUG"
# EMBEDDING_SERVICE_URL=""    # set to http://localhost:5100 for remote embeddings
