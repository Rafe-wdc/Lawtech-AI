# ── Required API Keys ────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
GOOGLE_API_KEY="AIza..."

# ── Auth (P0-1) ───────────────────────────────────────────────────────────────
# Comma-separated keys for user-facing endpoints (/search, /chat, /mainqa, etc.)
# Leave empty for open dev mode (with startup warning).
API_KEYS="your-user-key-1,your-user-key-2"

# Single key for admin endpoints (/admin/*, /metrics)
ADMIN_API_KEY="your-admin-key"

# ── CORS (P0-2) ───────────────────────────────────────────────────────────────
# Restrict to your domain(s) in production. Use "*" for open dev mode.
ALLOWED_ORIGINS="https://your-domain.com"

# Also update monitoring/prometheus.yml: set credentials to match ADMIN_API_KEY

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# ELASTICSEARCH_URL="http://139.84.219.174:9200"
# S3_BUCKET="lawttorney"
# S3_REGION="ap-south-1"
# REDIS_URL="redis://localhost:6379"
# HOST="0.0.0.0"
# PORT="5000"
# RATE_LIMIT_PER_MINUTE="10"
# EMBEDDING_SERVICE_URL=""     # set to http://localhost:5100 for remote embeddings
# CHAT_HISTORY_DB_PATH=""      # default: data/chat_history.db
