# monitoring/.env.example
# Copy to monitoring/.env and fill in SMTP credentials to enable email alerts.
# docker-compose reads this file automatically when it's named .env in the same dir.

GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your-gmail@gmail.com
GF_SMTP_PASSWORD=your-16-char-app-password   # Google: Security → App passwords
GF_SMTP_FROM_ADDRESS=your-gmail@gmail.com
GF_SMTP_FROM_NAME=Lawtech Alerts
